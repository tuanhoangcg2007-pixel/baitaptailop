import numpy as np
import pandas as pd
from sklearn.linear_model import Perceptron
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from sklearn.preprocessing import StandardScaler

data = pd.read_csv("/content/dulieu.csv")
data.columns = ['OrderSize', 'Distance', 'Fragile', 'Priority']
print(data.head())

x = data.loc[:, ['OrderSize', 'Distance', 'Fragile']]
y = data.loc[:, 'Priority']

x_train, x_test, y_train, y_test = train_test_split(
    x,
    y,
    test_size=0.3,
    random_state=42
)

print("Kích thước train:", x_train.shape)
print("Kích thước test:", x_test.shape)

sc = StandardScaler()

sc.fit(x_train)

x_train_std = sc.transform(x_train)
x_test_std = sc.transform(x_test)

model = Perceptron(
    max_iter=1000,
    eta0=0.05,
    random_state=0
)

model.fit(x_train_std, y_train)

y_pred = model.predict(x_test_std)

print("Độ chính xác mô hình:", accuracy_score(y_test, y_pred))

new_orders = np.array([
    [12,30,1],
    [70,250,0],
    [25,60,0],
    [4,8,1]
])

new_orders_std = sc.transform(new_orders)

predictions = model.predict(new_orders_std)

print("\nKết quả dự đoán:")

for i in range(len(new_orders)):
    print(f"Đơn hàng {new_orders[i]} -> Priority: {predictions[i]}")
